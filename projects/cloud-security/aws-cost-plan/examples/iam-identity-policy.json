{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOneFixturePrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::portfolio-fixture-logs",
        "arn:aws:s3:::portfolio-fixture-logs/lab/*"
      ]
    },
    {
      "Sid": "PassOneLabRoleWithMfa",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::111122223333:role/portfolio-lab-role",
      "Condition": {"Bool": {"aws:MultiFactorAuthPresent": "true"}}
    }
  ]
}
